{
  "rules": [
    {
      "name": "Employee Compliance Rule",
      "description": "Example rule for a Private Limited company with 100 or more employees",
      "category": "Employee",
      "priority": 1,
      "frequency": "Annual",
      "effective_from": "2025-04-01",
      "effective_to": null,
      "condition_logic": "AND",
      "obligation": "Example employee-related compliance obligation",
      "source": "Development source",
      "conditions": [
        {
          "field": "employee_count",
          "operator": ">=",
          "value": "100"
        },
        {
          "field": "entity_type",
          "operator": "==",
          "value": "Private Limited"
        }
      ]
    },
    {
      "name": "GST Registration Rule",
      "description": "Example rule for GST-registered businesses",
      "category": "GST",
      "priority": 1,
      "frequency": "Monthly",
      "effective_from": "2025-04-01",
      "effective_to": null,
      "condition_logic": "AND",
      "obligation": "Example GST compliance obligation",
      "source": "Development source",
      "conditions": [
        {
          "field": "gst_registered",
          "operator": "==",
          "value": "true"
        }
      ]
    },
    {
      "name": "High Business Size Rule",
      "description": "Example rule where either employee count or turnover reaches the threshold",
      "category": "Business Size",
      "priority": 2,
      "frequency": "Annual",
      "effective_from": "2025-04-01",
      "effective_to": null,
      "condition_logic": "OR",
      "obligation": "Example high-business-size compliance obligation",
      "source": "Development source",
      "conditions": [
        {
          "field": "employee_count",
          "operator": ">=",
          "value": "100"
        },
        {
          "field": "annual_turnover",
          "operator": ">=",
          "value": "50000000"
        }
      ]
    },
    {
      "name": "EPF Coverage Threshold",
      "description": "Simplified development rule for establishments with 20 or more employees",
      "category": "Employee",
      "priority": 1,
      "frequency": "Ongoing",
      "effective_from": "2025-11-21",
      "effective_to": null,
      "condition_logic": "AND",
      "obligation": "Check EPF applicability and registration requirements",
      "source": "Ministry of Labour and Employment",
      "conditions": [
        {
          "field": "employee_count",
          "operator": ">=",
          "value": "20"
        }
      ]
    },
    {
      "name": "Maharashtra Shops and Establishments Coverage",
      "description": "Simplified development rule for establishments in Maharashtra employing 10 or more workers",
      "category": "Labour",
      "priority": 2,
      "frequency": "Ongoing",
      "effective_from": "2017-09-07",
      "effective_to": null,
      "condition_logic": "AND",
      "obligation": "Check applicable registration and employment-condition requirements",
      "source": "Maharashtra Shops and Establishments Act, 2017",
      "conditions": [
        {
          "field": "location",
          "operator": "==",
          "value": "Maharashtra"
        },
        {
          "field": "employee_count",
          "operator": ">=",
          "value": "10"
        }
      ]
    },
    {
      "name": "ESIC Coverage Threshold",
      "description": "Simplified development rule for establishments with 10 or more employees",
      "category": "Employee",
      "priority": 1,
      "frequency": "Ongoing",
      "effective_from": "2025-11-21",
      "effective_to": null,
      "condition_logic": "AND",
      "obligation": "Check ESI applicability and registration requirements",
      "source": "Ministry of Labour and Employment",
      "conditions": [
        {
          "field": "employee_count",
          "operator": ">=",
          "value": "10"
        }
      ]
    }
  ]
}